# Copy this file to ".env" and fill in your own values. Never commit the real .env file.

# Your MongoDB connection string.
# Local MongoDB:      mongodb://127.0.0.1:27017/travel-partner
# MongoDB Atlas (free tier): mongodb+srv://<user>:<password>@<cluster-url>/travel-partner
MONGO_URI=mongodb://127.0.0.1:27017/travel-partner

# Port the Express server will listen on
PORT=5000

# The URL your React client runs on, used for CORS
CLIENT_URL=http://localhost:5173
